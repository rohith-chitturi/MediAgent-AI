# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL="postgresql://mediagent:mediagent_pass@localhost:5432/mediagent_db"

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET="your-super-secret-access-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── SERVER ──────────────────────────────────────────────────
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:5173"

# ─── AI AGENT SERVICE ────────────────────────────────────────
AI_AGENT_SERVICE_URL="http://localhost:8000"
AI_AGENT_API_KEY="internal-service-key-change-in-production"

# ─── GOOGLE GEMINI ───────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"

# ─── VAPI (Voice Agent) ──────────────────────────────────────
VAPI_API_KEY="your-vapi-api-key"
VAPI_PHONE_NUMBER_ID="your-vapi-phone-number-id"
VAPI_WEBHOOK_SECRET="your-vapi-webhook-secret"

# ─── RESEND (Email) ──────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="alerts@mediagent.ai"

# ─── TWILIO (SMS) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
